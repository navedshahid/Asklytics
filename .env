# SQL Server default DSN (optional; Settings UI can override at runtime)
QP_SQL_DSN=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost,1433;DATABASE=AdventureWorks2017;UID=report_user;PWD=Strong!Pass;TrustServerCertificate=yes;

# Runtime knobs
QP_TIMEOUT=30
QP_ROW_CAP=5000

# Paths
QP_CATALOG_DIR=./catalog/artifacts
QP_AUDIT_DB=./storage/audit.sqlite

QP_MODEL_PATH=./models/sqlcoder-7b-2.q8_0.gguf
QP_MODEL_CTX=8096
QP_MODEL_NGPU=-1   # if you compiled llama-cpp with CUDA; else set 0 for CPU
# how many tokens to process per batch (larger is faster but uses more RAM/VRAM)
QP_MODEL_NBATCH=1024
# number of CPU threads (already auto-set, but you can pin)
OMP_NUM_THREADS=8
